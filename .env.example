# ==============================================================================
# FAIZAN BAKERY - ENVIRONMENT VARIABLES FOR VERCEL DEPLOYMENT
# ==============================================================================

# For Supabase / Neon / Vercel Postgres:
# 1. Transaction Pooler URL (Used for fast serverless queries on Vercel)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Direct Connection URL (Used for Prisma migrations & db push)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Optional: Next.js public base URL
NEXT_PUBLIC_APP_URL="https://faizan-bakery.vercel.app"
